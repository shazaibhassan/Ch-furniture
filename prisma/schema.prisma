// CH FURNITURE — Prisma schema
// Database: PostgreSQL
// Run: npx prisma db push  (or: npx prisma migrate dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// AUTH — single admin (can be extended to multiple). NextAuth credentials.
// ----------------------------------------------------------------------------
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("Administrator")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// CATALOG
// ----------------------------------------------------------------------------
model Category {
  id          String      @id @default(cuid())
  // URL slug, e.g. "sofas" -> /category/sofas
  slug        String      @unique
  name        String
  description String?     @db.Text
  // Cloudinary public_id / secure_url for the category banner + thumbnail
  bannerUrl   String?
  thumbUrl    String?
  // Display ordering on the categories page
  sortOrder   Int         @default(0)
  featured    Boolean     @default(false)
  // Hero video shown at the top of the category page (auto-plays, muted)
  heroVideoUrl       String?
  heroVideoPosterUrl String?
  // When true the product grid shows autoplaying videos instead of thumbnail images
  videoMode   Boolean     @default(false)
  // SEO overrides (optional)
  metaTitle       String?
  metaDescription String? @db.Text
  furniture   Furniture[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([featured])
  @@index([sortOrder])
}

model Furniture {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  // Free-text style label shown on cards + used by filters: Modern, Classic, Traditional, Luxury, Hand Carved
  style       String?
  // Wood type used for the "Wood Type" filter: Sheesham, Walnut, Oak, Teak, etc.
  woodType    String?
  finish      String?
  dimensions  String?
  shortDesc   String?  @db.Text
  description String?  @db.Text
  // Bullet feature list, stored as JSON string[] for portability
  features    String?  @db.Text
  featured    Boolean  @default(false)
  bestSeller  Boolean  @default(false)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  images      Image[]
  videos      Video[]

  // SEO overrides
  metaTitle       String?
  metaDescription String? @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([bestSeller])
  @@index([published])
  @@index([style])
  @@index([woodType])
}

model Image {
  id          String     @id @default(cuid())
  url         String     // Cloudinary secure_url
  publicId    String     // Cloudinary public_id (for deletion)
  alt         String?
  width       Int?
  height      Int?
  isPrimary   Boolean    @default(false)
  sortOrder   Int        @default(0)
  furnitureId String?
  furniture   Furniture? @relation(fields: [furnitureId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([furnitureId])
}

model Video {
  id          String     @id @default(cuid())
  url         String     // Cloudinary secure_url (mp4) or external URL
  publicId    String?    // Cloudinary public_id (null if external)
  posterUrl   String?    // thumbnail/poster frame
  title       String?
  sortOrder   Int        @default(0)
  furnitureId String?
  furniture   Furniture? @relation(fields: [furnitureId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([furnitureId])
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  role      String?  // e.g. "Interior Designer, Lahore"
  quote     String   @db.Text
  rating    Int      @default(5)
  avatarUrl String?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// CONTACT FORM SUBMISSIONS
// ----------------------------------------------------------------------------
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
}

// ----------------------------------------------------------------------------
// SITE SETTINGS — single row (id = "singleton"). Editable from admin panel.
// All contact info, social links, SEO, business hours, WhatsApp number, etc.
// ----------------------------------------------------------------------------
model Settings {
  id              String @id @default("singleton")

  // Brand
  brandName       String @default("CH FURNITURE")
  tagline         String @default("Crafting Premium Wooden Furniture with Timeless Elegance.")
  description     String @default("") @db.Text

  // Contact
  address         String @default("Mohala Sardaaran, Near HBL Bank, Kalaswala, Pasrur, Sialkot, Punjab, Pakistan")
  phone           String @default("+92 341 6309652")
  whatsapp        String @default("+92 341 6309652")
  email           String @default("")
  businessHours   String @default("Mon – Sat: 9:00 AM – 8:00 PM") @db.Text
  mapEmbedUrl     String @default("") @db.Text

  // Prefilled WhatsApp message
  whatsappMessage String @default("Hello CH FURNITURE,\nI saw your website and I'm interested in one of your furniture designs. Could you please provide more information?") @db.Text

  // Social
  facebook        String @default("")
  instagram       String @default("")
  youtube         String @default("")
  tiktok          String @default("")
  linkedin        String @default("")

  // SEO
  seoTitle        String @default("CH FURNITURE | Premium Wooden Furniture Manufacturer in Sialkot, Pakistan")
  seoDescription  String @default("CH FURNITURE manufactures premium custom wooden furniture including sofas, beds, dining tables, chairs, office furniture, carved furniture, swings, wardrobes, TV units, and luxury handcrafted furniture in Sialkot, Pakistan.") @db.Text
  seoKeywords     String @default("Furniture Manufacturer Pakistan, Furniture Sialkot, Wooden Furniture, Luxury Furniture, Sofa Manufacturer, Bed Manufacturer, Dining Table, Carved Furniture, Solid Wood Furniture, Office Furniture, Custom Furniture, Handcrafted Furniture, Premium Furniture Pakistan") @db.Text
  ogImageUrl      String @default("")

  // About page content (editable)
  aboutStory          String @default("") @db.Text
  aboutMission        String @default("") @db.Text
  aboutVision         String @default("") @db.Text
  aboutExperience     String @default("") @db.Text
  yearsExperience     Int    @default(15)
  projectsCompleted   Int    @default(1200)
  happyClients        Int    @default(800)
  craftsmenCount      Int    @default(40)

  updatedAt       DateTime @updatedAt
}
