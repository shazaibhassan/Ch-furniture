# ----- Database (PostgreSQL) -----
# Local example: postgresql://postgres:password@localhost:5432/chfurniture
# Vercel Postgres / Neon / Supabase: copy the connection string here
DATABASE_URL="postgresql://user:password@host:5432/chfurniture?schema=public"

# ----- NextAuth -----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ----- Admin seed credentials (used by prisma/seed.ts) -----
ADMIN_EMAIL="admin@chfurniture.com"
ADMIN_PASSWORD="ChangeMe!2025"
ADMIN_NAME="CH Furniture Admin"

# ----- Cloudinary -----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Unsigned upload preset for client-side widget (create in Cloudinary dashboard)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="ch_furniture_unsigned"

# ----- Public site URL (for sitemap, OG, canonical) -----
NEXT_PUBLIC_SITE_URL="https://chfurniture.vercel.app"
